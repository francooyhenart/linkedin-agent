# Copiá este archivo como .env y completá lo que necesites.
# (Windows: copy .env.example .env)

# --- Servidor ---
# Por seguridad solo escucha en tu máquina. No lo cambies a 0.0.0.0: la API no tiene login.
HOST=127.0.0.1
PORT=8000

# --- Postgres (docker-compose.yml lee estas tres) ---
POSTGRES_USER=linkedin
POSTGRES_PASSWORD=linkedin
POSTGRES_DB=linkedin_agent
# Si cambiás los valores de arriba, cambialos también acá.
# Usá 127.0.0.1 y no "localhost": en Windows localhost puede resolver a IPv6 y Docker no responde ahí.
DATABASE_URL=postgresql+psycopg://linkedin:linkedin@127.0.0.1:5432/linkedin_agent

# --- Fechas ---
# Lista de zonas: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/Argentina/Buenos_Aires

# --- Modelo local (Ollama) ---
# Usá 127.0.0.1 y no "localhost" (mismo problema de IPv6 que con Postgres en Windows).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# --- LinkedIn (opcional: sin esto la app funciona en modo "publicar a mano") ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback

# --- Scheduler ---
# Si la compu estuvo apagada y un post se atrasó más que esto, no sale solo.
MAX_LATE_HOURS=12
# false = el scheduler no arranca y no se publica nada solo (útil para depurar).
SCHEDULER_ENABLED=true
